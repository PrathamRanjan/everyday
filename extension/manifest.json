{
  "manifest_version": 3,
  "name": "Everyday",
  "version": "0.1.0",
  "description": "Save a product you see, plan it within your own rules, and check a basket against your monthly limit. Works with the Everyday PayPal sandbox demo.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Everyday",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://pph-everyday.onrender.com/*",
    "http://localhost:4111/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After registering ${APP_URL}/webhooks/paypal on the PayPal app
PAYPAL_WEBHOOK_ID=
APP_URL=http://localhost:3500
PORT=3500
# Unset = PGlite in ./data
DATABASE_URL=
SESSION_SECRET=
# Telegram: set the bot token, then register ${APP_URL}/c/telegram/webhook with secret_token = TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Screenshot object reading. Unset = links/seeded clips/typed descriptions only.
ANTHROPIC_API_KEY=
EV_DEMO_MODE=true
EV_INLINE_WORKER=true

# ---- Foundation (9 Nov 2026) ----
# Model provider. AI_PROVIDER=openai with a key turns on: policy compilation from plain words,
# screenshot frame reading (vision tier) and the model arm of the capture eval. Unset = rules only.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL_VISION=
AI_MODEL_READ=
AI_MODEL_CLASSIFY=
# Approvals above this amount (cents) need a second click (countersign) before they release.
EV_COUNTERSIGN_ABOVE_CENTS=20000
# Channel3 product search for the passport (unset = catalog fallback, labelled as such).
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
# Shopper/merchant approval channels. Telegram webhook: ${APP_URL}/webhooks/telegram (secret header = TELEGRAM_WEBHOOK_SECRET).
# WhatsApp Cloud API webhook: ${APP_URL}/webhooks/whatsapp (GET verify uses WHATSAPP_VERIFY_TOKEN).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=everyday-verify
# Web push for the PWA. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Log in with PayPal button (needs a sandbox app with Log in with PayPal enabled).
PAYPAL_LOGIN_ENABLED=false
# Separate PGlite dir for eval runs so they do not fight the dev server for the data dir.
# PGLITE_PATH=./data/pglite-eval

# Voice notes transcription model (OpenAI)
AI_MODEL_TRANSCRIBE=

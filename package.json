{
  "name": "everyday",
  "version": "0.1.0",
  "private": true,
  "description": "Everyday: a personal buying and ownership assistant, from a shared clip to an owned, supported purchase.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "worker": "node --env-file-if-exists=.env dist/worker-main.js",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "eval:capture": "tsx --env-file-if-exists=.env scripts/eval-capture.ts",
    "eval:techjam": "tsx --env-file-if-exists=.env scripts/eval-techjam.ts",
    "eval:adversarial": "tsx --env-file-if-exists=.env scripts/eval-adversarial.ts",
    "build:web": "npm --prefix web ci --include=dev --no-audit --no-fund && npm --prefix web run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/busboy": "^1.5.5",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "zod": "^3.25.76",
    "sharp": "^0.34.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@types/web-push": "^3.6.4"
  }
}
